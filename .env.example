# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Friends need this code to create an account. The very first account (yours) needs no code.
# Leave empty to close sign-ups.
INVITE_CODE=

# Any S3-compatible bucket. Backblaze B2 example (R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto):
S3_ENDPOINT=https://s3.<REGION>.backblazeb2.com
S3_REGION=<REGION>
S3_BUCKET=link-cable
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Uploads are refused once the whole bucket would exceed this (keeps you inside a free tier)
STORAGE_LIMIT_GB=9
